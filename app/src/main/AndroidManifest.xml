<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="rs.rez.audio" android:versionCode="3" android:versionName="1.2">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <queries><package android:name="com.junkfood.seal" /></queries>
    <application android:label="@string/app_name" android:theme="@style/AppTheme" android:icon="@drawable/ic_launcher" android:allowBackup="false" android:supportsRtl="true">
